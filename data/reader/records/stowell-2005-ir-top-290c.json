ion":"available","product_facts":"available"},"general_background":[{"id":"top-chalcogen","title":"A phosphine can carry a chalcogen feed","summary":"Trioctylphosphine can solubilize elemental selenium or tellurium as a phosphine chalcogenide for colloidal growth. Delivering the chalcogen in this bonded form changes the chemistry that supplies reactive growth species.","label":"General background, not the authors' interpretation","reference":{"doi":"10.1021/ja00072a025","url":"https://doi.org/10.1021/ja00072a025","title":"Synthesis and characterization of nearly monodisperse CdE (E = sulfur, selenium, tellurium) semiconductor nanocrystallites","authors":["C. B. Murray","D. J. Norris","M. G. Bawendi"],"year":1993,"metadata_response_sha256":"4d24baddb03828d85088876ca0b66dc3416fcd1267f7d46e9ef26bd4591d894c","resolver_redirect_verified":true,"exact_DOI_metadata_verified":true,"paper_or_abstract_requested":false},"reagent_specific":true,"topic":"phosphine-chalcogenide"},{"id":"chloroform-dispersion","title":"Solvent choice follows the surface coating","summary":"Chloroform can disperse many nanocrystals coated with organic ligands after colloidal growth. This dispersibility reflects the particle surface and does not establish that the crystalline core dissolved.","label":"General background, not the authors' interpretation","reference":{"doi":"10.1021/cr900137k","url":"https://doi.org/10.1021/cr900137k","title":"Prospects of Colloidal Nanocrystals for Electronic and Optoelectronic Applications","authors":["Dmitri V. Talapin","Jong-Soo Lee","Maksym V. Kovalenko","Elena V. Shevchenko"],"year":2010,"metadata_response_sha256":"438529d4d25fa4e3163f426928f09cb807d83528218a6faca98a79ab85e784df","resolver_redirect_verified":true,"exact_DOI_metadata_verified":true,"paper_or_abstract_requested":false},"reagent_specific":true,"topic":"solvent-ligand-dispersibility"},{"id":"nitrogen-blanket","title":"An inert atmosphere limits oxygen exposure","summary":"A nitrogen blanket can limit oxygen exposure during hot solution synthesis when an air-sensitive feed or surface is present. It helps preserve the intended precursor and surface chemistry without being a source of the nanocrystal elements.","label":"General background, not the authors' interpretation","reference":{"doi":"10.1021/ja00072a025","url":"https://doi.org/10.1021/ja00072a025","title":"Synthesis and characterization of nearly monodisperse CdE (E = sulfur, selenium, tellurium) semiconductor nanocrystallites","authors":["C. B. Murray","D. J. Norris","M. G. Bawendi"],"year":1993,"metadata_response_sha256":"4d24baddb03828d85088876ca0b66dc3416fcd1267f7d46e9ef26bd4591d894c","resolver_redirect_verified":true,"exact_DOI_metadata_verified":true,"paper_or_abstract_requested":false},"reagent_specific":true,"topic":"inert-reaction-atmosphere"},{"id":"hot-injection-nucleation","title":"Nucleation and size focusing","summary":"A rapid change in precursor availability can create a short nucleation period followed by growth on existing particles. Growth can narrow the size distribution while material is supplied, whereas later ripening can consume smaller particles and change that distribution again.","label":"General background, not the authors' interpretation","reference":{"doi":"10.1021/cr400544s","url":"https://doi.org/10.1021/cr400544s","title":"Mechanisms of Nucleation and Growth of Nanoparticles in Solution","authors":["Nguyen T. K. Thanh","N. Maclean","S. Mahiddine"],"year":2014,"metadata_response_sha256":"997f5bb631896f547843d7cf01573d11c3d62d6de6a941962d5c52a408320998","resolver_redirect_verified":true,"exact_DOI_metadata_verified":true,"paper_or_abstract_requested":false},"reagent_specific":false,"topic":"nucleation-and-focusing"}]}
