opic":"ligand-exchange-accessibility"},{"id":"chloroform-dispersion","title":"Solvent choice follows the surface coating","summary":"Chloroform can disperse many nanocrystals coated with organic ligands after colloidal growth. This dispersibility reflects the particle surface and does not establish that the crystalline core dissolved.","label":"General background, not the authors' interpretation","reference":{"doi":"10.1021/cr900137k","url":"https://doi.org/10.1021/cr900137k","title":"Prospects of Colloidal Nanocrystals for Electronic and Optoelectronic Applications","authors":["Dmitri V. Talapin","Jong-Soo Lee","Maksym V. Kovalenko","Elena V. Shevchenko"],"year":2010,"metadata_response_sha256":"438529d4d25fa4e3163f426928f09cb807d83528218a6faca98a79ab85e784df","resolver_redirect_verified":true,"exact_DOI_metadata_verified":true,"paper_or_abstract_requested":false},"reagent_specific":true,"topic":"solvent-ligand-dispersibility"}]}
