a30ac0153629988595d1deefc8393a00158","resolver_redirect_verified":true,"exact_DOI_metadata_verified":true,"paper_or_abstract_requested":false},"reagent_specific":true,"topic":"ode-polymerization"},{"id":"oleate-surface","title":"Oleate and the nanocrystal surface","summary":"Bound oleate can stabilize dispersed metal chalcogenide nanocrystals, and not all surface carboxylate need occupy the same binding environment. Displacing metal carboxylate from the surface can change surface stoichiometry as well as colloidal stability.","label":"General background, not the authors' interpretation","reference":{"doi":"10.1021/ja4086758","url":"https://doi.org/10.1021/ja4086758","title":"Ligand Exchange and the Stoichiometry of Metal Chalcogenide Nanocrystals: Spectroscopic Observation of Facile Metal-Carboxylate Displacement and Binding","authors":["Nicholas C. Anderson","Mark P. Hendricks","Joshua J. Choi","Jonathan S. Owen"],"year":2013,"metadata_response_sha256":"10288c4ef333174b71bca1a3ed53534054d28ad6c6e5cc3ee649f168e94d5212","resolver_redirect_verified":true,"exact_DOI_metadata_verified":true,"paper_or_abstract_requested":false},"reagent_specific":true,"topic":"carboxylate-surface"},{"id":"oleylamine-surface","title":"A primary amine can change surface growth","summary":"Oleylamine can coordinate soluble metal species and bind exposed surface sites during colloidal growth. It can therefore change how rapidly precursors react and how readily the resulting particles remain dispersed.","label":"General background, not the authors' interpretation","reference":{"doi":"10.1021/cm4000476","url":"https://doi.org/10.1021/cm4000476","title":"Oleylamine in Nanoparticle Synthesis","authors":["Stefanos Mourdikoudis","Luis M. Liz-Marzán"],"year":2013,"metadata_response_sha256":"10145cffa0994fbf2433c60f1c7ca0580cda251d1fbe3d72e8e219b1849dace1","resolver_redirect_verified":true,"exact_DOI_metadata_verified":true,"paper_or_abstract_requested":false},"reagent_specific":true,"topic":"amine-surface"}]}
